{
  "_readme": "Every spec is an object: value (in the unit listed under 'fields'), source (an id from 'sources'), status ('verified' or 'unverified'), and an optional note. The app reads labels and units from 'fields', so adding a field here does not require changing the table code.",

  "fields": {
    "wingspan":     { "label": "Wingspan",                 "unit": "m" },
    "wingArea":     { "label": "Wing area",                "unit": "m²" },
    "length":       { "label": "Length",                   "unit": "m" },
    "mtow":         { "label": "Max takeoff weight (MTOW)", "unit": "kg" },
    "typicalRange": { "label": "Typical range",            "unit": "nmi" },
    "typicalSeats": { "label": "Typical seats",            "unit": "seats" },
    "engineModel":  { "label": "Engine",                   "unit": null },
    "engineThrust": { "label": "Thrust (per engine)",      "unit": "kN" },
    "cruiseSpeed":  { "label": "Cruise speed",             "unit": "Mach" }
  },

