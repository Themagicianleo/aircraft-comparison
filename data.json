  "aircraft": [
    {
      "id": "b777-300er",
      "name": "Boeing 777-300ER",
      "manufacturer": "Boeing",
      "specs": {
        "wingspan": {
          "value": 64.8,
          "source": "skybrary-b77w",
          "status": "unverified",
          "note": "SKYbrary gives 64.80 m. A Boeing 777X brochure lists the 777-300ER at 212.8 ft (64.8 m), but that PDF has since been removed from boeing.com. Check against Boeing's 777-300ER airport planning document (Rev G)."
        },
        "wingArea": {
          "value": 436.8,
          "source": "wikipedia-777",
          "status": "unverified",
          "note": "Commonly cited figure (4,702 sq ft), not confirmed in a Boeing document. flugzeuginfo.net gives 427.8 m², but for the 777-300, which has a shorter wing without raked tips. Check against the Boeing airport planning document."
        },
        "length": {
          "value": 73.9,
          "source": "skybrary-b77w",
          "status": "unverified",
          "note": "Commonly published as 242 ft 4 in (73.86 m)."
        },
        "mtow": {
          "value": 351534,
          "source": "flightglobal-777-mtow",
          "status": "unverified",
          "note": "Published as 775,000 lb, converted here (× 0.45359237). SKYbrary gives 351,530 kg. Lower MTOW options also exist."
        },
        "typicalRange": {
          "value": 7370,
          "source": "boeing-777-acaps",
          "status": "unverified",
          "note": "7,370 nmi (13,650 km) is widely quoted as Boeing's figure, but sources disagree: SKYbrary lists 7,930 nmi and FlightGlobal 7,705 nmi. Check the payload/range chart in the Boeing document."
        },
        "typicalSeats": {
          "value": 396,
          "source": "boeing-777-acaps",
          "status": "unverified",
          "note": "Two-class layout. Boeing's older marketing figure was 365. Boeing counts two classes and Airbus counts three, so seat numbers are not directly comparable."
        },
        "engineModel": {
          "value": "GE90-115B",
          "source": "skybrary-b77w",
          "status": "unverified"
        },
        "engineThrust": {
          "value": 513,
          "source": "skybrary-b77w",
          "status": "unverified",
          "note": "115,300 lbf (≈ 513 kN). SKYbrary rounds to 511 kN. Check the FAA type certificate data sheet for the GE90."
        },
        "cruiseSpeed": {
          "value": 0.84,
          "source": "skybrary-b77w",
          "status": "unverified"
        }
      }
    },

